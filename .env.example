# Local development defaults only. Never put API keys here.
# Users supply OpenAI / Gemini / Claude keys in the UI (sent as request headers).

APP_NAME=NCD Guideline Tutor
APP_ENV=development

# Paths (relative to repo root unless absolute)
DATA_DIR=data
INDEX_DIR=indexes

EMBEDDING_MODEL=all-MiniLM-L6-v2
RERANK_MODEL=ms-marco-MiniLM-L-12-v2

CHUNK_SIZE_CHARS=3200
CHUNK_OVERLAP_CHARS=600

DEFAULT_TOP_K=8
RERANK_CANDIDATES=20
HYBRID_RRF_K=60

# Optional local defaults for CLI evals only — leave blank in git.
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
# ANTHROPIC_API_KEY=
